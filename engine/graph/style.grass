node {
  diameter: 50px;
  color: #A5ABB6;
  border-color: #9AA1AC;
  border-width: 2px;
  text-color-internal: #FFFFFF;
  font-size: 10px;
}
relationship {
  color: #A5ABB6;
  shaft-width: 2px;
  font-size: 8px;
  padding: 3px;
  text-color-external: #000000;
  text-color-internal: #FFFFFF;
  caption: "<type>";
}
node.Member {
  color: #263238;
  border-color: #000A12;
  diameter: 70px;
  font-size: 12px;
  caption: "{name}";
}
node.Condition {
  color: #90A4AE;
  border-color: #62757F;
  diameter: 40px;
  caption: "{display}";
}
node.Medication {
  color: #6A1B9A;
  border-color: #38006B;
  diameter: 50px;
  caption: "{name}";
}
node.TherapyClass {
  color: #00838F;
  border-color: #005662;
  diameter: 60px;
  caption: "{name}";
}
node.Risk {
  color: #5D4037;
  border-color: #321911;
  diameter: 55px;
  caption: "{monitor}";
}
node.Alert {
  color: #9E9E9E;
  border-color: #707070;
  diameter: 55px;
  caption: "{title}";
}
node.Clinical {
  color: #C62828;
  border-color: #8E0000;
  diameter: 65px;
  caption: "{title}";
}
node.Nudge {
  color: #EF6C00;
  border-color: #B53D00;
  diameter: 58px;
  caption: "{title}";
}
node.Informational {
  color: #1565C0;
